// prisma-client-js generates plain JavaScript, which this CommonJS server can
// require directly. Prisma 7's newer "prisma-client" generator emits
// TypeScript only and would need a compile step.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReadingSlot {
  MORNING
  AFTER_BREAKFAST
  AFTER_LUNCH
  AFTER_DINNER
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now()) @map("created_at")
  readings  Reading[]

  @@map("users")
}

model Reading {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  readingDate DateTime    @map("reading_date") @db.Date
  slot        ReadingSlot
  value       Int
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, readingDate, slot])
  @@index([userId, readingDate])
  @@map("readings")
}
