# ---- server/.env ----
NODE_ENV=development
PORT=4000
# PostgreSQL connection string for the development database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sweety?schema=public"
# Long random string used to sign JWTs (e.g. `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN=7d
# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173
# Timezone that defines "today" for the no-future-dates rule
APP_TIMEZONE=Asia/Kolkata
# bcrypt cost factor (use 4 in .env.test to keep tests fast)
BCRYPT_SALT_ROUNDS=12

# ---- server/.env.test ----
# Same variables as above, pointing at a separate database that tests may wipe:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sweety_test?schema=public"

